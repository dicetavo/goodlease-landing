---
// Écran d'app illustré (maquette UI en code) : feed "Explorer" de GoodLease.
// Destiné à être slotté dans <PhoneMockup>. Aucun texte généré par IA, tout est net.
import ListingCard from './ListingCard.astro';

interface Listing {
  title: string;
  category: string;
  icon: string;
  location: string;
  rating: string;
  reviews: number;
  price: string;
  pro?: boolean;
  tone?: string;
}
interface Props {
  listings: Listing[];
}
const { listings } = Astro.props;

const chips = ['Tout', 'Son', 'Lumière', 'Mobilier', 'Déco'];

const tabs = [
  { label: 'Explorer', active: true, icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>' },
  { label: 'Favoris', active: false, icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>' },
  { label: 'Louer', active: false, icon: '<path d="M5 12h14M12 5v14"/>' },
  { label: 'Messages', active: false, icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>' },
  { label: 'Compte', active: false, icon: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>' },
];
---

<div class="flex h-full flex-col bg-canvas text-ink">
  <!-- barre d'état -->
  <div class="flex items-center justify-between px-5 pt-3 text-[10px] font-semibold">
    <span>9:41</span>
    <span class="flex items-center gap-1">
      <svg width="15" height="10" viewBox="0 0 24 22" fill="currentColor" aria-hidden="true">
        <rect x="1" y="14" width="3" height="6" rx="1" /><rect x="7" y="10" width="3" height="10" rx="1" /><rect x="13" y="6" width="3" height="14" rx="1" /><rect x="19" y="2" width="3" height="18" rx="1" />
      </svg>
      <svg width="20" height="10" viewBox="0 0 24 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="1" y="2" width="18" height="10" rx="2.5" /><rect x="3" y="4" width="13" height="6" rx="1.2" fill="currentColor" stroke="none" /><line x1="21.5" x2="21.5" y1="6" y2="8" />
      </svg>
    </span>
  </div>

  <!-- en-tête -->
  <div class="flex items-center justify-between px-4 pb-2 pt-2">
    <div class="flex items-center gap-2">
      <img src="/mark.svg" alt="" aria-hidden="true" class="h-6 w-6" />
      <div class="leading-tight">
        <p class="text-[9px] font-medium text-muted">Autour de</p>
        <p class="flex items-center gap-0.5 text-xs font-bold text-ink">
          Lille
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </p>
      </div>
    </div>
    <span class="relative flex h-8 w-8 items-center justify-center rounded-full bg-white shadow-soft">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1A1C1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
      </svg>
      <span class="absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-danger"></span>
    </span>
  </div>

  <!-- recherche -->
  <div class="px-4">
    <div class="flex items-center gap-2 rounded-full border border-line bg-white px-3 py-2 shadow-soft">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6C7278" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
      <span class="text-[11px] text-muted">Rechercher du matériel…</span>
    </div>
  </div>

  <!-- filtres -->
  <div class="mt-3 flex gap-2 overflow-hidden px-4">
    {chips.map((c, i) => (
      <span class={`whitespace-nowrap rounded-full px-3 py-1 text-[10px] font-semibold ${i === 0 ? 'bg-primary text-white' : 'border border-line bg-white text-ink'}`}>{c}</span>
    ))}
  </div>

  <!-- feed -->
  <div class="mt-3 flex-1 space-y-3 overflow-hidden px-4">
    {listings.map((l) => <ListingCard {...l} />)}
  </div>

  <!-- barre d'onglets -->
  <div class="flex items-center justify-around border-t border-line bg-white px-2 pb-4 pt-2">
    {tabs.map((t) => (
      <span class={`flex flex-col items-center gap-0.5 ${t.active ? 'text-primary' : 'text-muted'}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
        <span class="text-[8px] font-medium">{t.label}</span>
      </span>
    ))}
  </div>
</div>
