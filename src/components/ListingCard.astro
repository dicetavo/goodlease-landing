---
// Carte d'annonce illustrée (maquette UI en code — pas une vraie capture).
// Visuel = photo d'annonce générée (prop `image`) ou, à défaut, dégradé de
// marque + icône du matériel. Dans les deux cas : rendu propre et sans PII.
import { Image } from 'astro:assets';

interface Props {
  title: string;
  category: string;
  /** Photo d'annonce (import depuis src/assets/annonces/) — prioritaire sur l'icône */
  image?: ImageMetadata;
  /** Inner SVG (paths) de l'icône matériel */
  icon: string;
  tone?: string;
  class?: string;
}
const {
  title,
  category,
  image,
  icon,
  tone = 'a',
  class: className = '',
} = Astro.props;

const tones: Record<string, string> = {
  a: 'from-primary to-primary-dark',
  b: 'from-primary-bold to-primary-border',
  c: 'from-ink-2 to-ink',
  d: 'from-[#3D8BF7] to-[#155EEF]',
};
---

<article class={`overflow-hidden rounded-2xl border border-line bg-surface shadow-soft ${className}`}>
  <div class={`relative flex aspect-[4/3] items-center justify-center bg-gradient-to-br ${tones[tone] ?? tones.a}`}>
    {image ? (
      <Image
        src={image}
        alt={`Illustration : ${title}`}
        width={640}
        height={480}
        format="webp"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-12 w-12 text-white/85"
        aria-hidden="true"
        set:html={icon}
      />
    )}
    <span class="absolute right-2.5 top-2.5 flex h-7 w-7 items-center justify-center rounded-full bg-white/90 text-ink shadow-sm">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
      </svg>
    </span>
    <span class="absolute left-2.5 top-2.5 rounded-full bg-white/95 px-2 py-0.5 text-[10px] font-semibold text-ink shadow-sm">
      Illustration
    </span>
    <span class="absolute bottom-2.5 left-2.5 rounded-full bg-black/25 px-2 py-0.5 text-[10px] font-medium text-white backdrop-blur-sm">
      {category}
    </span>
  </div>
  <div class="p-3.5">
    <p class="line-clamp-1 text-sm font-semibold leading-snug text-ink">{title}</p>
    <p class="mt-1 text-[11px] leading-relaxed text-muted">
      Tarifs et disponibilités dans le catalogue.
    </p>
  </div>
</article>
