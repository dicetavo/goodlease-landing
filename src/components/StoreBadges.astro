---
import { stores } from '../config';

interface Props {
  /** Taille des badges */
  size?: 'md' | 'lg';
  /** Centrer horizontalement */
  center?: boolean;
  class?: string;
}
const { size = 'md', center = false, class: className = '' } = Astro.props;

const h = size === 'lg' ? 'h-14' : 'h-12';
const appLive = Boolean(stores.appStore);
const playLive = Boolean(stores.playStore);
// Libellé du pill selon ce qui manque encore (rien si les deux stores sont en ligne).
const comingSoonLabel = !appLive && !playLive
  ? 'Bientôt disponible'
  : !playLive
    ? 'Bientôt sur Google Play'
    : !appLive
      ? 'Bientôt sur l’App Store'
      : '';
---

<!--
  Badges officiels (chartes de marque Apple/Google — ne pas modifier les fichiers) :
  - app-store-fr.svg : « Télécharger dans l'App Store » FR, endpoint officiel
    tools.applemediaservices.com (Download_on_the_App_Store_Badge_FR_RGB_blk_100517).
  - google-play-fr.svg : artwork officiel « Disponible sur Google Play » (google-play-badge-fr.eps).
-->
<div class={`flex flex-col gap-3 ${center ? 'items-center' : 'items-start'} ${className}`}>
  <div class={`flex flex-wrap items-center gap-3 ${center ? 'justify-center' : ''}`}>
    <!-- App Store -->
    <a
      href={appLive ? stores.appStore : undefined}
      target={appLive ? '_blank' : undefined}
      rel={appLive ? 'noopener' : undefined}
      aria-label="Télécharger dans l’App Store"
      class={`${appLive ? '' : 'pointer-events-none opacity-90'} transition hover:opacity-80 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-[8px]`}
    >
      <img src="/badges/app-store-fr.svg" alt="" width="127" height="40" class={`${h} w-auto`} />
    </a>

    <!-- Google Play -->
    <a
      href={playLive ? stores.playStore : undefined}
      target={playLive ? '_blank' : undefined}
      rel={playLive ? 'noopener' : undefined}
      aria-label="Disponible sur Google Play"
      class={`${playLive ? '' : 'pointer-events-none opacity-90'} transition hover:opacity-80 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-[8px]`}
    >
      <img src="/badges/google-play-fr.svg" alt="" width="861" height="255" class={`${h} w-auto`} />
    </a>
  </div>

  {
    comingSoonLabel && (
      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-100 px-3 py-1 text-xs font-medium text-primary">
        <span class="h-1.5 w-1.5 rounded-full bg-primary" />
        {comingSoonLabel}
      </span>
    )
  }
</div>
