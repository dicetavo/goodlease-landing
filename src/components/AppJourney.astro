---

<section id="parcours" class="scroll-mt-20">
  <div class="container-gl py-20 lg:py-24">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="eyebrow">Toutes les étapes de l’app</span>
      <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Le parcours complet, côté locataire et loueur</h2>
      <p class="mt-4 text-muted">
        Une vue claire de tout ce que GoodLease prend en charge : compte, recherche, réservation,
        remise du matériel, état des lieux, retour, annonces, paiements et support.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {
        tracks.map((track, ti) => (
          <article class="journey-track" data-reveal style={`--reveal-delay:${ti * 80}ms`}>
            <div class="border-b border-line pb-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-primary">{track.label}</p>
              <h3 class="mt-2 text-xl font-semibold">{track.tagline}</h3>
            </div>

            <div class="mt-6 space-y-5">
              {track.phases.map((phase, pi) => (
                <section class="journey-phase" data-reveal style={`--reveal-delay:${(pi + 1) * 70}ms`}>
                  <div class="flex items-center gap-3">
                    <span class="journey-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[phase.icon]} />
                    </span>
                    <h4 class="text-[15px] font-semibold">{phase.title}</h4>
                  </div>

                  <ol class="mt-4 space-y-3 border-l border-line pl-5">
                    {phase.steps.map((step) => (
                      <li class="relative">
                        <span class="journey-dot" aria-hidden="true" />
                        <p class="text-sm font-medium text-ink">{step.name}</p>
                        <p class="mt-0.5 text-sm leading-relaxed text-muted">{step.desc}</p>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12" data-reveal>
      <h3 class="text-center text-sm font-semibold uppercase tracking-wider text-muted">
        Et tout au long du parcours
      </h3>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          transversal.map((item, i) => (
            <div class="journey-cross" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <span class="journey-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
              </span>
              <div>
                <p class="text-sm font-semibold">{item.name}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-muted">{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .journey-phase,
  .journey-cross {
    border: 1px solid #eeeeee;
    background: #ffffff;
    box-shadow: 0 8px 24px -6px rgba(26, 28, 30, 0.1);
  }

  .journey-track {
    min-width: 0;
  }

  .journey-phase {
    border-radius: 14px;
    padding: 18px;
  }

  .journey-cross {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    border-radius: 14px;
    padding: 18px;
  }

  .journey-icon {
    display: inline-flex;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #e9f2fe;
    color: #1675f3;
  }

  .journey-dot {
    position: absolute;
    top: 5px;
    left: -23px;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #1675f3;
    box-shadow: 0 0 0 4px #e9f2fe;
  }
</style>
