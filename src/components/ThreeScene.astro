---
---

<section id="atelier" class="three-section relative isolate overflow-hidden bg-ink text-white">
  <canvas data-three-scene class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <div class="three-vignette pointer-events-none absolute inset-0"></div>

  <div class="container-gl relative z-10 py-28 text-center lg:py-36">
    <div class="mx-auto max-w-2xl" data-reveal>
      <span class="eyebrow !bg-white/10 !text-white">Logistique simplifiée</span>
      <h2 class="mt-5 text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-5xl">
        Montez votre événement comme un pro.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/70">
        Sonorisation, lumières, structures, mobilier : GoodLease assemble les pièces du bon matériel,
        au bon endroit, au bon moment.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="#parcours" class="btn bg-white text-ink hover:bg-white/90">Voir le parcours</a>
        <a href="#telecharger" class="btn border border-white/25 text-white hover:bg-white/10">
          Télécharger l’app
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-three-scene]');

  if (canvas) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const saveData = Boolean(connection?.saveData);
    let started = false;

    const start = async () => {
      if (started || saveData) return;
      started = true;

      const THREE = await import('three');
      const section = canvas.closest('section') as HTMLElement;
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
      });
      renderer.setClearColor(0x000000, 0);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(44, 1, 0.1, 100);
      camera.position.set(0, 0, 9);

      scene.add(new THREE.AmbientLight(0xffffff, 0.55));

      const key = new THREE.DirectionalLight(0xffffff, 1.8);
      key.position.set(4, 5, 7);
      scene.add(key);

      const rim = new THREE.PointLight(0x1675f3, 80, 36);
      rim.position.set(-5, -2, 5);
      scene.add(rim);

      const group = new THREE.Group();
      scene.add(group);

      const blue = new THREE.MeshStandardMaterial({ color: 0x1675f3, metalness: 0.32, roughness: 0.34 });
      const pale = new THREE.MeshStandardMaterial({ color: 0xe9f2fe, metalness: 0.16, roughness: 0.42 });
      const line = new THREE.MeshStandardMaterial({ color: 0x8bc0ff, wireframe: true, transparent: true, opacity: 0.72 });
      const dark = new THREE.MeshStandardMaterial({ color: 0x232f51, metalness: 0.22, roughness: 0.38 });

      type FloatingMesh = {
        mesh: any;
        baseY: number;
        amp: number;
        speed: number;
        spin: number;
        phase: number;
      };

      const meshes: FloatingMesh[] = [];

      const add = (
        geometry: any,
        material: any,
        position: [number, number, number],
        scale = 1,
      ) => {
        const mesh = new THREE.Mesh(geometry, material);
        mesh.position.set(...position);
        mesh.scale.setScalar(scale);
        mesh.rotation.set(position[1] * 0.2, position[0] * 0.18, position[2] * 0.08);
        group.add(mesh);
        meshes.push({
          mesh,
          baseY: position[1],
          amp: 0.18 + Math.abs(position[0]) * 0.04,
          speed: 0.55 + Math.abs(position[2]) * 0.08,
          spin: 0.004 + scale * 0.002,
          phase: position[0] + position[1],
        });
        return mesh;
      };

      add(new THREE.BoxGeometry(1.4, 1.15, 1.05), dark, [-3.2, -0.7, 0.2], 1);
      add(new THREE.CylinderGeometry(0.34, 0.42, 0.18, 32), blue, [-3.2, -0.7, 0.78], 1);
      add(new THREE.CylinderGeometry(0.22, 0.28, 0.16, 32), pale, [-3.2, -0.7, 0.9], 1);
      add(new THREE.ConeGeometry(0.92, 1.5, 5), pale, [3.0, 1.0, -0.9], 1);
      add(new THREE.TorusGeometry(0.86, 0.18, 18, 48), blue, [-2.4, 1.35, -0.8], 1);
      add(new THREE.BoxGeometry(1.28, 1.28, 1.28), blue, [2.55, -1.35, 0.35], 1);
      add(new THREE.TetrahedronGeometry(1.05, 0), line, [0.25, 1.95, -1.6], 1);
      add(new THREE.IcosahedronGeometry(1.65, 0), line, [0, -0.05, -3], 1);
      add(new THREE.DodecahedronGeometry(0.72, 0), pale, [0.55, -2.05, 0.75], 1);
      add(new THREE.OctahedronGeometry(0.55, 0), blue, [-4.35, 1.85, -1.15], 1);

      const pointsGeometry = new THREE.BufferGeometry();
      const positions = new Float32Array(90);
      for (let i = 0; i < positions.length; i += 3) {
        positions[i] = (Math.random() - 0.5) * 10;
        positions[i + 1] = (Math.random() - 0.5) * 5.6;
        positions[i + 2] = -2 - Math.random() * 4;
      }
      pointsGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const points = new THREE.Points(
        pointsGeometry,
        new THREE.PointsMaterial({ color: 0x8bc0ff, size: 0.035, transparent: true, opacity: 0.7 }),
      );
      scene.add(points);

      let pointerX = 0;
      let pointerY = 0;
      let scrollProgress = 0;
      let raf = 0;
      let running = false;

      const updateScroll = () => {
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight || 1;
        scrollProgress = Math.max(0, Math.min(1, (vh - rect.top) / (vh + rect.height)));
      };

      const resize = () => {
        const width = Math.max(1, canvas.clientWidth || section.clientWidth);
        const height = Math.max(1, canvas.clientHeight || section.clientHeight);
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };

      const render = (time = 0) => {
        const t = time * 0.001;

        for (const item of meshes) {
          item.mesh.position.y = item.baseY + Math.sin(t * item.speed + item.phase) * item.amp;
          item.mesh.rotation.x += item.spin;
          item.mesh.rotation.y += item.spin * 1.3;
        }

        points.rotation.y = t * 0.04;
        group.rotation.y += (pointerX * 0.42 + scrollProgress * Math.PI * 0.58 - group.rotation.y) * 0.055;
        group.rotation.x += (pointerY * 0.22 - group.rotation.x) * 0.055;
        renderer.render(scene, camera);
      };

      const loop = (time: number) => {
        if (!running) return;
        render(time);
        raf = requestAnimationFrame(loop);
      };

      const play = () => {
        if (running) return;
        running = true;
        raf = requestAnimationFrame(loop);
      };

      const pause = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      window.addEventListener(
        'pointermove',
        (event) => {
          pointerX = (event.clientX / Math.max(1, window.innerWidth)) * 2 - 1;
          pointerY = (event.clientY / Math.max(1, window.innerHeight)) * 2 - 1;
        },
        { passive: true },
      );
      window.addEventListener('scroll', updateScroll, { passive: true });

      resize();
      updateScroll();
      render(0);

      if ('ResizeObserver' in window) new ResizeObserver(resize).observe(section);
      else window.addEventListener('resize', resize);

      if (reduceMotion) {
        return;
      }

      if ('IntersectionObserver' in window) {
        const visibility = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) play();
            else pause();
          },
          { threshold: 0.01 },
        );
        visibility.observe(section);
      } else {
        play();
      }
    };

    if ('IntersectionObserver' in window && !saveData) {
      const loader = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            start();
            loader.disconnect();
          }
        },
        { rootMargin: '320px' },
      );
      loader.observe(canvas);
    } else {
      start();
    }
  }
</script>

<style>
  .three-section {
    min-height: 78vh;
    display: flex;
    align-items: center;
  }

  .three-vignette {
    background:
      linear-gradient(90deg, rgba(26, 28, 30, 0.82) 0%, rgba(26, 28, 30, 0.38) 45%, rgba(26, 28, 30, 0.82) 100%),
      linear-gradient(180deg, rgba(26, 28, 30, 0.45) 0%, rgba(26, 28, 30, 0.2) 44%, rgba(26, 28, 30, 0.75) 100%);
  }

  [data-three-scene] {
    display: block;
  }

  @media (max-width: 767px) {
    .three-section {
      min-height: 680px;
    }

    .three-vignette {
      background:
        linear-gradient(90deg, rgba(26, 28, 30, 0.86) 0%, rgba(26, 28, 30, 0.5) 50%, rgba(26, 28, 30, 0.86) 100%),
        linear-gradient(180deg, rgba(26, 28, 30, 0.6) 0%, rgba(26, 28, 30, 0.32) 42%, rgba(26, 28, 30, 0.82) 100%);
    }
  }
</style>
