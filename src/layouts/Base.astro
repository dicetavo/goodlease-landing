---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, analytics, stores, emails, company } from '../config';
import MarketingConsent from '../components/MarketingConsent.astro';

interface Props {
  title: string;
  description?: string;
  /** Schéma org+app uniquement sur la home */
  homeSchema?: boolean;
  ogImage?: string;
  robots?: string;
  canonical?: string | false;
}

const {
  title,
  description = site.description,
  homeSchema = false,
  ogImage = '/og-default.png',
  robots = 'index,follow,max-image-preview:large',
} = Astro.props;

const canonical = Astro.props.canonical === false ? undefined : new URL(Astro.props.canonical || Astro.url.pathname, site.url).href;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} · ${site.name}`;
const ogUrl = new URL(ogImage, site.url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- Google Search Console — propriété https://goodlease.fr/ ; ne pas supprimer (le statut de propriétaire est re-vérifié périodiquement) -->
    <meta name="google-site-verification" content="SFG0dMk6KQygWFWcJe6APSicPiNG14HTlSV9pr2DJ_Q" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1675F3" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {
      homeSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@graph': [
              {
                '@type': 'Organization',
                '@id': `${site.url}/#organization`,
                name: 'GoodLease',
                url: site.url,
                logo: `${site.url}/icon-1024.png`,
                email: emails.contact,
                legalName: company.legalName,
                sameAs: [stores.appStore, stores.playStore].filter(Boolean),
                contactPoint: { '@type': 'ContactPoint', email: emails.support, contactType: 'customer support', availableLanguage: 'fr' },
                areaServed: { '@type': 'Country', name: 'France' },
                address: {
                  '@type': 'PostalAddress',
                  ...company.postalAddress,
                },
              },
              {
                '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name,
                url: site.url, inLanguage: 'fr-FR', description: site.description,
                publisher: { '@id': `${site.url}/#organization` },
              },
              {
                '@type': 'MobileApplication',
                name: 'GoodLease',
                operatingSystem: 'iOS, Android',
                applicationCategory: 'LifestyleApplication',
                offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
                ...(stores.appStore || stores.playStore
                  ? { installUrl: [stores.appStore, stores.playStore].filter(Boolean) }
                  : {}),
              },
            ],
          })}
        />
      )
    }

    {
      /* Analytics cookieless (Plausible) — actif dès que analytics.plausibleDomain est renseigné dans config.ts */
      analytics.plausibleDomain && (
        <script defer data-domain={analytics.plausibleDomain} src="https://plausible.io/js/script.js" />
      )
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-btn focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MarketingConsent />

    <script>
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (revealEls.length) {
        if (reduceMotion || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
          );

          revealEls.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>
