---
import Base from '../layouts/Base.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import ThreeScene from '../components/ThreeScene.astro';
import AppJourney from '../components/AppJourney.astro';
import ListingCard from '../components/ListingCard.astro';
import ExplorerScreen from '../components/ExplorerScreen.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { routes } from '../config';

import shotMicros from '../assets/screenshots/03-micros.png';

// Photos d'annonces générées (IA, style catalogue cohérent) — cf. src/assets/annonces/
import photoEnceinte from '../assets/annonces/enceinte.png';
import photoParLed from '../assets/annonces/par-led.png';
import photoTente from '../assets/annonces/tente.png';
import photoTablesChaises from '../assets/annonces/tables-chaises.png';
import photoMachineFumee from '../assets/annonces/machine-fumee.png';
import photoMicrosHf from '../assets/annonces/micros-hf.png';
import photoArcheFlorale from '../assets/annonces/arche-florale.png';
import photoMangeDebout from '../assets/annonces/mange-debout.png';

const steps = [
  {
    n: '1',
    title: 'Recherchez',
    text: 'Trouvez tout le matériel de votre événement près du lieu : sonorisation, mobilier, tentes, déco, éclairage… Filtrez par dates et par lieu.',
  },
  {
    n: '2',
    title: 'Réservez',
    text: 'Réservez en quelques minutes. Le paiement et le dépôt de garantie sont sécurisés via Stripe — vous êtes protégé.',
  },
  {
    n: '3',
    title: 'Restituez',
    text: 'Récupérez le matériel, profitez de votre événement, puis restituez-le à la date convenue. Le dépôt de garantie est libéré automatiquement.',
  },
];

// Angle événementiel : ce que GoodLease équipe et comment il simplifie la logistique.
const eventTypes = [
  'Mariage',
  'Anniversaire',
  'Soirée & fête',
  'Séminaire & pro',
  'Festival & concert',
  'Réception',
  'Inauguration',
  'Vide-grenier',
];

const eventPerks = [
  {
    title: 'Tout au même endroit',
    text: 'Sonorisation, mobilier, tentes, déco, éclairage, vaisselle… Réunissez tout le matériel de l’événement sans multiplier les prestataires.',
    icon: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  },
  {
    title: 'Près du lieu',
    text: 'Louez à proximité du lieu de réception : moins de transport, retrait et installation simplifiés.',
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: 'Pile sur vos dates',
    text: 'Réservez au calendrier pour la durée exacte de l’événement, week-end et jours fériés compris.',
    icon: '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/>',
  },
  {
    title: 'Sans acheter ni stocker',
    text: 'Pas d’achat coûteux, pas de stockage après l’événement. Vous louez juste le temps qu’il faut.',
    icon: '<rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>',
  },
];

const owners = [
  { title: 'Rentabilisez votre matériel', text: 'Mettez en location ce que vous n’utilisez pas tous les jours et générez un revenu complémentaire.' },
  { title: 'Dépôt de garantie maîtrisé', text: 'Une empreinte de garantie est posée à chaque location et restituée si tout se passe bien.' },
  { title: 'Annonces modérées', text: 'Les annonces et les photos sont vérifiées pour garder une marketplace fiable et de qualité.' },
  { title: 'Paiement sécurisé via Stripe', text: 'Les fonds transitent par Stripe Connect. Vous recevez vos paiements directement sur votre compte.' },
];

const renters = [
  { title: 'Une grande variété de matériel', text: 'Du matériel événementiel et professionnel disponible près de chez vous, sans l’acheter.' },
  { title: 'Un prix juste', text: 'Louez au prix fixé par le loueur, en toute transparence. Tous les frais sont affichés avant de payer.' },
  { title: 'Un bail sécurisé', text: 'Identité des loueurs pros vérifiée, dépôt de garantie encadré, paiement intermédié.' },
  { title: 'Un support à l’écoute', text: 'Une question, un imprévu ? Notre service client vous accompagne du lundi au vendredi.' },
];

const trust = [
  { title: 'Vérification d’identité', text: 'Les loueurs professionnels font l’objet d’une vérification KYC (Stripe) conforme au DSA.' },
  { title: 'Dépôt de garantie', text: 'Empreinte bancaire posée puis restituée via Stripe — GoodLease n’est pas dépositaire des fonds.' },
  { title: 'Médiation de la consommation', text: 'En cas de litige, une médiation de la consommation est prévue, en plus de notre support.' },
  { title: 'Transparence des frais', text: 'Le montant de la commission et le prix TTC sont affichés au moment de la réservation.' },
];

// Annonces illustrées (maquettes UI en code, pas de vraies captures) — style marketplace.
const catIcons = {
  speaker: '<rect width="16" height="20" x="4" y="2" rx="2"/><circle cx="12" cy="14" r="4"/><path d="M12 6h.01"/>',
  light: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1.2-1.3 1.5-2.5 1.5-4a6 6 0 1 0-12 0c0 1.5.3 2.7 1.5 4 .8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  tent: '<path d="M3.5 21 14 3"/><path d="M20.5 21 10 3"/><path d="M15.5 21 12 15l-3.5 6"/><path d="M2 21h20"/>',
  chair: '<path d="M6 19v2M18 19v2"/><path d="M5 11h14v3a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z"/><path d="M7 11V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v5"/>',
  sparkles: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>',
  mic: '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/>',
  flower: '<circle cx="12" cy="12" r="2.5"/><path d="M12 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 1 1 0 5"/><path d="M12 14.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 1 0 0-5"/><path d="M9.5 12a2.5 2.5 0 1 1-5 0 2.5 2.5 0 1 1 5 0"/><path d="M14.5 12a2.5 2.5 0 1 0 5 0 2.5 2.5 0 1 0-5 0"/>',
};

const listings = [
  { title: 'Enceinte active 15" + caisson', category: 'Sonorisation', image: photoEnceinte, icon: catIcons.speaker, location: 'Lille · 2,3 km', rating: '4,9', reviews: 32, price: '25', pro: true, tone: 'a' },
  { title: 'Pack 4 PAR LED RGBW', category: 'Éclairage', image: photoParLed, icon: catIcons.light, location: 'Roubaix · 5 km', rating: '4,8', reviews: 17, price: '30', tone: 'b' },
  { title: 'Tente de réception 4×8 m', category: 'Mobilier', image: photoTente, icon: catIcons.tent, location: 'Lens · 12 km', rating: '5,0', reviews: 8, price: '90', pro: true, tone: 'c' },
  { title: '10 tables + 40 chaises', category: 'Mobilier', image: photoTablesChaises, icon: catIcons.chair, location: 'Douai · 9 km', rating: '4,7', reviews: 21, price: '45', tone: 'd' },
  { title: 'Machine à fumée + DMX', category: 'Effets', image: photoMachineFumee, icon: catIcons.sparkles, location: 'Lille · 1,1 km', rating: '4,9', reviews: 12, price: '18', tone: 'b' },
  { title: 'Micros HF (paire)', category: 'Sonorisation', image: photoMicrosHf, icon: catIcons.mic, location: "Villeneuve-d'Ascq · 6 km", rating: '4,8', reviews: 40, price: '15', pro: true, tone: 'a' },
  { title: 'Arche florale + déco', category: 'Décoration', image: photoArcheFlorale, icon: catIcons.flower, location: 'Lille · 3,4 km', rating: '4,9', reviews: 15, price: '35', tone: 'd' },
  { title: 'Mange-debout (lot de 8)', category: 'Mobilier', image: photoMangeDebout, icon: catIcons.chair, location: 'Arras · 18 km', rating: '4,6', reviews: 9, price: '12', tone: 'c' },
];
const heroListings = listings.slice(0, 3);
---

<Base title="GoodLease" homeSchema>
  <!-- Bandeau de confirmation double opt-in : Brevo redirige ici (/?confirm=1) après clic dans l'e-mail. -->
  <div id="confirm-banner" class="hidden border-b border-success/30 bg-success/10">
    <div class="container-gl flex items-center justify-center gap-2 py-3 text-center text-sm font-medium text-success">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5" />
      </svg>
      Votre inscription est confirmée — merci ! On vous prévient dès le lancement.
    </div>
  </div>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-32 left-1/2 h-[480px] w-[820px] -translate-x-1/2 rounded-full bg-primary-100 blur-3xl opacity-60"></div>
      <div class="absolute -right-24 top-20 h-72 w-72 rounded-full bg-primary-200 blur-3xl opacity-40"></div>
      <div class="absolute left-[7%] top-[60%] h-3 w-3 rounded-full bg-primary/30"></div>
      <div class="absolute right-[13%] top-[18%] h-2.5 w-2.5 rounded-full bg-primary/40"></div>
      <div class="absolute left-[42%] top-[12%] h-2 w-2 rounded-full bg-primary/25"></div>
    </div>
    <div class="container-gl grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <div data-reveal>
        <span class="eyebrow">Bientôt disponible · iOS & Android</span>
        <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] sm:text-[3.25rem]">
          Équipez vos événements sans rien acheter.
          <span class="text-primary">Rentabilisez le matériel que vous possédez.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          Sonorisation, mobilier, tentes, déco, éclairage… GoodLease réunit tout le matériel
          pour réussir vos événements, à louer près de chez vous et sur vos dates.
          Réservez en quelques clics, payez en sécurité, profitez d’un bail protégé.
        </p>

        <div id="telecharger" class="mt-8 max-w-lg scroll-mt-24 space-y-7">
          <div>
            <p class="mb-3 flex items-center gap-2 text-sm font-medium text-ink">
              <img src="/icon-1024.png" alt="" aria-hidden="true" class="h-8 w-8 rounded-[8px] shadow-soft" />
              Téléchargez l’app GoodLease
            </p>
            <StoreBadges />
          </div>

          <div class="border-t border-line pt-6">
            <p class="mb-3 text-sm font-medium text-muted">
              Pas encore lancée — rejoignez la liste d’attente, on vous prévient au lancement :
            </p>
            <WaitlistForm compact />
          </div>
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end" data-reveal style="--reveal-delay:120ms">
        <PhoneMockup alt="Aperçu de l’application GoodLease — explorer les annonces" class="rotate-[2deg]">
          <ExplorerScreen listings={heroListings} />
        </PhoneMockup>
      </div>
    </div>
  </section>

  <!-- ANNONCES (maquettes UI illustrées, pas de vraies captures) -->
  <section id="annonces" class="scroll-mt-20 border-y border-line bg-surface">
    <div class="container-gl py-20 lg:py-24">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow">Des annonces près de chez vous</span>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">Un aperçu de la marketplace</h2>
        <p class="mt-4 text-muted">
          Du matériel d’événementiel proposé par des particuliers et des pros vérifiés,
          à louer à la journée, près de chez vous.
        </p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          listings.map((l, i) => (
            <div data-reveal style={`--reveal-delay:${i * 55}ms`}>
              <ListingCard {...l} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- POUR VOS ÉVÉNEMENTS -->
  <section id="evenements" class="scroll-mt-20 bg-gradient-to-b from-primary-50 to-transparent">
    <div class="container-gl py-20 lg:py-24">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow">Pour vos événements</span>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">Tout votre événement, équipé au même endroit</h2>
        <p class="mt-4 text-muted">
          Mariage, anniversaire, soirée, séminaire ou festival : réunissez tout le matériel
          dont vous avez besoin sur une seule plateforme, près du lieu et sur vos dates.
          GoodLease simplifie la logistique, vous profitez de l’événement.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {
          eventTypes.map((e, i) => (
            <span class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink" data-reveal style={`--reveal-delay:${i * 35}ms`}>
              {e}
            </span>
          ))
        }
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          eventPerks.map((f, i) => (
            <div class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <Fragment set:html={f.icon} />
                </svg>
              </div>
              <h3 class="mt-4 text-base font-semibold">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- COMMENT ÇA MARCHE -->
  <section id="comment-ca-marche" class="scroll-mt-20 border-y border-line bg-surface">
    <div class="container-gl py-20">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow">Comment ça marche</span>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">Louer du matériel, simplement</h2>
        <p class="mt-4 text-muted">Trois étapes, de la recherche à la restitution.</p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <div class="card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary text-lg font-bold text-white">
                {s.n}
              </div>
              <h3 class="mt-5 text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECTION 3D IMMERSIVE -->
  <ThreeScene />

  <!-- TOUTES LES ÉTAPES DE L'APP -->
  <AppJourney />

  <!-- POUR LES LOUEURS -->
  <section id="loueurs" class="scroll-mt-20">
    <div class="container-gl py-20">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div class="order-2 flex justify-center lg:order-1">
          <PhoneMockup
            image={shotMicros}
            alt="Mettre du matériel en location sur GoodLease"
            class="-rotate-[2deg]"
          />
        </div>
        <div class="order-1 lg:order-2" data-reveal>
          <span class="eyebrow">Pour les loueurs</span>
          <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">Votre matériel travaille pour vous</h2>
          <p class="mt-4 text-muted">
            Particulier ou professionnel, mettez vos équipements en location et gardez le contrôle.
          </p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {
              owners.map((f) => (
                <div>
                  <h3 class="flex items-center gap-2 text-[15px] font-semibold">
                    <span class="text-primary">●</span>
                    {f.title}
                  </h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{f.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- POUR LES LOCATAIRES -->
  <section class="border-y border-line bg-surface">
    <div class="container-gl py-20">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow">Pour les locataires</span>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl lg:text-5xl">Tout le matériel, sans l’acheter</h2>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          renters.map((f, i) => (
            <div class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <h3 class="text-base font-semibold">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SÉCURITÉ & CONFIANCE (section sombre — rythme clair/foncé) -->
  <section class="bg-ink text-white">
    <div class="container-gl py-24 lg:py-28">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow !bg-white/10 !text-white">Sécurité &amp; confiance</span>
        <h2 class="mt-5 text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Louez l’esprit tranquille</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/70">
          La sécurité du bail est au cœur de GoodLease.
          <a href={routes.safety} class="font-medium text-primary-bold underline-offset-2 hover:underline">En savoir plus</a>.
        </p>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          trust.map((f, i) => (
            <div class="rounded-card border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/20">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4491F5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="M9 12l2 2 4-4" />
                </svg>
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/65">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA WAITLIST -->
  <section>
    <div class="container-gl py-20">
      <div class="mx-auto max-w-3xl rounded-card bg-primary px-8 py-12 text-center shadow-card sm:px-12" data-reveal>
        <img
          src="/icon-1024.png"
          alt="Icône de l’application GoodLease"
          class="mx-auto h-20 w-20 rounded-[20px] shadow-lg"
          width="80"
          height="80"
        />
        <h2 class="mt-6 text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">Soyez les premiers informés du lancement</h2>
        <p class="mx-auto mt-3 max-w-xl text-primary-100">
          Bientôt disponible sur l’App Store et Google Play. Laissez votre e-mail : on vous prévient dès la sortie.
        </p>

        <div class="mt-8 rounded-card bg-white/10 px-6 py-6">
          <StoreBadges center />
        </div>

        <div class="mx-auto mt-6 max-w-lg rounded-card bg-surface p-5 text-left">
          <WaitlistForm compact />
        </div>
      </div>
    </div>
  </section>

  <script>
    // Retour depuis l'e-mail de confirmation Brevo : on révèle le bandeau puis on nettoie l'URL
    // (replaceState) pour qu'un rafraîchissement ne le ré-affiche pas.
    if (new URLSearchParams(location.search).get('confirm') === '1') {
      document.getElementById('confirm-banner')?.classList.remove('hidden');
      history.replaceState(null, '', location.pathname);
    }
  </script>
</Base>
