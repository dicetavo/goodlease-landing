---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { publishedPosts, postHref, formatDate, type Post } from '../../blog';
import { site } from '../../config';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 3) } }));
}

const { post, others } = Astro.props as { post: Post; others: Post[] };
const { Content } = await render(post);
const url = new URL(postHref(post), site.url).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
      inLanguage: 'fr-FR',
      mainEntityOfPage: url,
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site.url).href },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
      ],
    },
  ],
};
---

<Base title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="border-b border-line bg-surface">
    <div class="container-gl py-12 sm:py-16">
      <nav aria-label="Fil d’Ariane" class="text-sm text-primary"><a href="/" class="hover:underline">Accueil</a> / <a href="/blog/" class="hover:underline">Blog</a></nav>
      <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-primary">{post.data.category}</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 text-xs text-muted">Publié le <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
    </div>
  </section>
  <article class="container-gl py-12">
    <div class="mx-auto max-w-3xl">
      <div class="prose-gl blog-content"><Content /></div>
      {post.data.cta && <p class="mt-10"><a class="btn-primary" href={post.data.cta.href}>{post.data.cta.label}</a></p>}
      <p class="mt-8 text-sm text-muted">Vous avez du matériel qui dort ? <a class="text-primary underline" href="/louer-son-materiel/">Mettez-le en location sur GoodLease</a>, c’est gratuit.</p>
    </div>
  </article>
  {others.length > 0 && (
    <section class="border-t border-line bg-surface">
      <div class="container-gl py-12">
        <h2 class="text-xl font-semibold">À lire aussi</h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-3">
          {others.map((p) => <li><a class="font-medium text-primary hover:underline" href={postHref(p)}>{p.data.title}</a></li>)}
        </ul>
      </div>
    </section>
  )}
</Base>

<style is:global>
  .blog-content table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 14px; }
  .blog-content th, .blog-content td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid #EEEEEE; vertical-align: top; }
  .blog-content th { font-weight: 600; }
  .blog-content ol { list-style: decimal; padding-left: 1.25rem; margin: 0.75rem 0; }
  .blog-content ol li { margin: 0.35rem 0; }
</style>
