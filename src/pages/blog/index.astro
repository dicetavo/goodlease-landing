---
import Base from '../../layouts/Base.astro';
import { publishedPosts, postHref, formatDate } from '../../blog';

const posts = await publishedPosts();
---

<Base title="Blog : conseils pour louer et mettre en location du matériel événementiel" description="Guides pratiques pour organiser vos événements, louer le bon matériel et rentabiliser celui que vous possédez : sono, lumière, photobooth, mobilier, décoration.">
  <section class="border-b border-line bg-surface">
    <div class="container-gl py-12 sm:py-16">
      <span class="eyebrow">Blog</span>
      <h1 class="mt-4 max-w-3xl text-3xl font-semibold sm:text-4xl">Louer ce qu’il vous faut, louer ce qui dort</h1>
      <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted">Guides pratiques pour organiser vos événements et choisir le bon matériel, et conseils pour rentabiliser celui que vous possédez.</p>
    </div>
  </section>
  <section class="container-gl py-12">
    {posts.length === 0 && <p class="text-muted">Les premiers articles arrivent très bientôt.</p>}
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <li class="rounded-card border border-line bg-surface p-6 transition hover:border-primary/40">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary">{post.data.category}</p>
          <h2 class="mt-3 text-lg font-semibold leading-snug"><a href={postHref(post)} class="hover:text-primary">{post.data.title}</a></h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{post.data.description}</p>
          <p class="mt-4 text-xs text-muted"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
        </li>
      ))}
    </ul>
  </section>
</Base>
