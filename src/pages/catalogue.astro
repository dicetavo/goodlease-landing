---
import Base from '../layouts/Base.astro';
---

<Base title="Catalogue de location" description="Découvrez le matériel proposé à la location sur GoodLease, par catégorie et par ville." robots="noindex,follow">
  <!-- Pages Functions remplace ce contenu par le catalogue public côté serveur. -->
  <div id="public-catalogue-content">
    <section class="container-gl py-20">
      <h1 class="text-3xl">Catalogue de location</h1>
      <p class="mt-4 text-muted">Consultez le catalogue GoodLease dans l’application.</p>
      <a href="/app/" class="btn-primary mt-6">Explorer le matériel</a>
    </section>
  </div>
</Base>
